// Modelo de dados do Minha Mente.
// Um pensamento (Post) pertence a uma ou mais categorias sem duplicar conteúdo.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id          String     @id @default(cuid())
  /// Numeração sequencial do arquivo, alocada pelo contador PostCounter.
  number      Int        @unique
  title       String
  slug        String     @unique
  /// Markdown. Renderizado sem HTML bruto.
  content     String
  private Boolean @default(false)
  status      PostStatus @default(DRAFT)
  /// Preenchida ao publicar. Uma data futura mantém o pensamento invisível até lá.
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categories Category[]

  @@index([status, publishedAt])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  /// Cor de destaque em hexadecimal (#RRGGBB).
  color       String   @default("#929292")
  /// Ordem de exibição na navegação.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts Post[]
}

model SiteSettings {
  id               String   @id @default("site")
  profileImageData String?
  updatedAt        DateTime @updatedAt
}

model PostCounter {
  id    String @id @default("posts")
  value Int
}

model Visitor {
  ip          String   @id
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Caminho da última página, sem query string.
  lastPath    String   @default("/")
  /// Visitas separadas por pelo menos 5 minutos, não requisições.
  visits      Int      @default(1)
}
