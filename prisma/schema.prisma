// Modelo de dados do Minha Mente.
// Um pensamento (Post) pertence a uma ou mais categorias sem duplicar conteúdo.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Post {
  id          String     @id @default(cuid()) @map("_id")
  /// Numeração sequencial do arquivo, alocada pelo contador do MongoDB.
  number      Int        @unique
  title       String
  slug        String     @unique
  /// Markdown. Renderizado sem HTML bruto.
  content     String
  status      PostStatus @default(DRAFT)
  /// Preenchida ao publicar. Uma data futura mantém o pensamento invisível até lá.
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  categoryIDs String[]
  categories  Category[] @relation(fields: [categoryIDs], references: [id])

  @@index([status, publishedAt])
}

model Category {
  id          String   @id @default(cuid()) @map("_id")
  name        String
  slug        String   @unique
  description String   @default("")
  /// Cor de destaque em hexadecimal (#RRGGBB).
  color       String   @default("#929292")
  /// Ordem de exibição na navegação.
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  postIDs String[]
  posts   Post[]   @relation(fields: [postIDs], references: [id])
}

model SiteSettings {
  id               String   @id @default("site") @map("_id")
  profileImageData String?
  updatedAt        DateTime @updatedAt
}

model PostCounter {
  id    String @id @default("posts") @map("_id")
  value Int
}
