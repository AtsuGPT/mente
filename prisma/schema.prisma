// Modelo de dados do Minha Mente.
// Um ambiente (Environment) é um espaço independente com seus próprios pensamentos,
// categorias e participantes. Um pensamento (Post) pertence a uma ou mais categorias
// do mesmo ambiente sem duplicar conteúdo.
//
// O ambiente original tem id "mente": é o valor padrão de environmentId, então os
// dados anteriores aos ambientes continuam nele sem nenhuma cópia.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  /// Sempre em minúsculas. Contas legadas usam o ADMIN_EMAIL / SITE_USERNAME do .env.
  username     String   @unique
  displayName  String
  /// scrypt:N:r:p:salt:hash. Nulo nas contas legadas, autenticadas pelo .env.
  passwordHash String?
  /// "ADMIN" ou "SITE" para as credenciais do .env; nulo para contas criadas no app.
  legacyKind   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  ownedEnvironments Environment[] @relation("EnvironmentOwner")
  invitesCreated    Invite[]
  posts             Post[]
  kallyConversations KallyConversation[]
  kallyDocuments     KallyDocument[]
  kallyMemories      KallyMemory[]
}

model Environment {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String    @default("")
  /// Cor de identidade em hexadecimal (#RRGGBB).
  color       String    @default("#7C5CE0")
  /// Nome de um ícone do app (brain, book, folder, bulb, users, sparkle).
  icon        String    @default("brain")
  /// Visitantes sem conta podem ler os pensamentos públicos.
  guestAccess Boolean   @default(false)
  /// Foto em data URL. No ambiente "mente" a foto vem de SiteSettings (a mesma do site).
  imageData   String?
  ownerId     String?
  /// Arquivado: some das listas e fica só para o proprietário. Nada é apagado.
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner      User?        @relation("EnvironmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members    Membership[]
  invites    Invite[]
  posts      Post[]     // fase-b
  categories Category[] // fase-b
  kallyConversations KallyConversation[]
  kallyChunks        KallyChunk[]
  kallyMemories      KallyMemory[]
}

model Membership {
  id               String     @id @default(cuid())
  environmentId    String
  userId           String
  role             MemberRole @default(VIEWER)
  /// Ajustes do proprietário sobre o padrão do papel (nulo = padrão do papel).
  canPublish       Boolean?
  canEditOwn       Boolean?
  canManageContent Boolean?
  canManageMembers Boolean?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([environmentId, userId])
  @@index([userId])
}

model Invite {
  id            String     @id @default(cuid())
  /// Código curto e aleatório; é o que vai no link de convite.
  code          String     @unique
  environmentId String
  role          MemberRole @default(VIEWER)
  /// Nulo = usos ilimitados.
  maxUses       Int?
  uses          Int        @default(0)
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime   @default(now())

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([environmentId])
}

model Post {
  id            String     @id @default(cuid())
  environmentId String     @default("mente")
  /// Numeração sequencial dentro do ambiente, alocada pelo contador PostCounter.
  number        Int
  title         String
  slug          String
  /// Markdown. Renderizado sem HTML bruto.
  content       String
  private       Boolean    @default(false)
  status        PostStatus @default(DRAFT)
  /// Preenchida ao publicar. Uma data futura mantém o pensamento invisível até lá.
  publishedAt   DateTime?
  /// Quem criou pelo app; nulo nos pensamentos anteriores aos ambientes.
  authorId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id]) // fase-b
  author      User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  categories  Category[]

  @@unique([environmentId, number])
  @@unique([environmentId, slug])
  @@index([status, publishedAt])
  @@index([environmentId, status, publishedAt])
}

model Category {
  id            String   @id @default(cuid())
  environmentId String   @default("mente")
  name          String
  slug          String
  description   String   @default("")
  /// Cor de destaque em hexadecimal (#RRGGBB).
  color         String   @default("#929292")
  /// Ordem de exibição na navegação.
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id]) // fase-b
  posts       Post[]

  @@unique([environmentId, slug])
}

model SiteSettings {
  id               String   @id @default("site")
  profileImageData String?
  updatedAt        DateTime @updatedAt
}

/// Contador da numeração dos pensamentos. "posts" é o do ambiente "mente";
/// os demais ambientes usam "posts:<environmentId>".
model PostCounter {
  id    String @id @default("posts")
  value Int
}

model Visitor {
  ip          String   @id
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Caminho da última página, sem query string.
  lastPath    String   @default("/")
  /// Visitas separadas por pelo menos 5 minutos, não requisições.
  visits      Int      @default(1)
}

/// Conversa com a Kally: de uma pessoa, dentro de um ambiente. Nunca é compartilhada;
/// só o dev da plataforma (legacyKind "ADMIN") pode lê-la, sem continuar nem apagar.
model KallyConversation {
  id            String   @id @default(cuid())
  environmentId String
  userId        String
  /// "chat" (perguntas sobre os pensamentos) ou "ideia" (transformar uma ideia em post).
  mode          String   @default("chat")
  title         String   @default("Nova conversa")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  environment Environment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    KallyMessage[]

  @@index([environmentId, userId, updatedAt])
}

model KallyMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// "user" ou "assistant".
  role           String
  content        String
  /// JSON com os pensamentos usados: [{ title, slug }].
  sources        String   @default("[]")
  createdAt      DateTime @default(now())

  conversation KallyConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Índice de significado da Kally (embeddings), por ambiente. Refeito sozinho quando o
/// conteúdo muda (hash) e limpo quando some. Conversas só entram para a própria dona.
model KallyChunk {
  id            String   @id @default(cuid())
  environmentId String
  /// "post" ou "conversa".
  kind          String
  refId         String
  /// Dona da conversa (nulo para posts): a busca só devolve conversas da própria pessoa.
  userId        String?
  chunk         Int
  hash          String
  text          String
  /// Vetor em JSON.
  vector        String
  updatedAt     DateTime @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([kind, refId, chunk])
  @@index([environmentId, kind])
}

/// Base de conhecimento da Kally (RAG). Não é treino: os trechos são consultados na hora da
/// pergunta e entram no contexto com a origem. "institucional" vale para todos e só o
/// administrador da plataforma alimenta; "pessoal" pertence a uma pessoa e só ela consulta.
model KallyDocument {
  id         String   @id @default(cuid())
  /// "institucional" ou "pessoal".
  scope      String
  /// Dona do documento pessoal (nulo no institucional).
  userId     String?
  title      String
  /// Origem identificável: nome do arquivo ou referência informada por quem enviou.
  origin     String
  /// pdf, docx, texto, markdown, csv.
  kind       String
  /// sha256 do texto extraído: o mesmo conteúdo não é reindexado.
  hash       String
  chars      Int
  /// Modelo de embeddings dos trechos; trocar de modelo exige reindexar.
  embedModel String
  /// "processando", "pronto" ou "erro".
  status     String   @default("processando")
  detail     String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks KallyDocumentChunk[]

  @@index([scope, userId])
}

model KallyDocumentChunk {
  id         String @id @default(cuid())
  documentId String
  position   Int
  /// Onde o trecho está no documento: "p. 3", "texto", "linhas 2–40".
  label      String
  text       String
  /// Vetor Float32 em bytes (4 bytes por dimensão).
  vector     Bytes

  document KallyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

/// Memória da Kally: pedaços de informação que a própria pessoa deu numa conversa SALVA (preferências, fatos
/// sobre ela, objetivos, contexto). Por pessoa e por ambiente; só ela vê e apaga. Entra no prompt só quando o
/// significado da mensagem se aproxima (src/server/kally/memory.ts). Conversa temporária não gera memória.
model KallyMemory {
  id             String    @id @default(cuid())
  environmentId  String
  userId         String
  text           String
  /// "preferencia", "fato", "objetivo" ou "contexto".
  kind           String    @default("fato")
  /// Conversa de onde veio (nula se a conversa foi apagada).
  conversationId String?
  /// Vetor Float32 em bytes (4 bytes por dimensão), do mesmo modelo de embeddings das bases.
  vector         Bytes
  embedModel     String
  uses           Int       @default(0)
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([environmentId, userId])
}
