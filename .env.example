# Copie para .env e preencha. Nunca versione o .env.

# SQLite local
DATABASE_URL="file:./mente.db"

# URL pública do site (metadados, sitemap, compartilhamento social)
SITE_URL="http://localhost:3000"

# Administrador único. Gere o hash com: npm run admin:hash
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_PASSWORD_HASH=""

# Opcional: credenciais para usuários com acesso a posts privados.
SITE_USERNAME="leitor"
SITE_PASSWORD_HASH=""

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Ollama deve estar em execução no servidor; o modelo padrão é llama3.2:latest.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:latest"

# Serviço Whisper local (a rota Next encaminha o áudio; mantenha o serviço em loopback).
WHISPER_URL="http://127.0.0.1:8001/transcribe"
