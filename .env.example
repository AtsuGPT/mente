# Copie para .env e preencha. Nunca versione o .env.

# SQLite local
DATABASE_URL="file:./mente.db"

# URL pública do site (metadados, sitemap, compartilhamento social)
SITE_URL="http://localhost:3000"

# Administrador único. Gere o hash com: npm run admin:hash
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_PASSWORD_HASH=""

# Opcional: credenciais para usuários com acesso a posts privados.
SITE_USERNAME="leitor"
SITE_PASSWORD_HASH=""

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Ollama deve estar em execução no servidor; o modelo padrão é llama3.2:latest.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:latest"

# Provedor de IA da Kally, do chat e das leituras (opcional; sem nada, usa o Ollama acima).
# AI_PROVIDER: "ollama" (local ou Ollama Cloud) ou "openai" (qualquer API compatível com
# /v1/chat/completions, como OpenRouter, Groq ou LM Studio). A chave fica só no servidor.
# Ollama Cloud: AI_PROVIDER="ollama" AI_BASE_URL="https://ollama.com" AI_MODEL="gpt-oss:20b" AI_API_KEY="..."
# AI_PROVIDER="ollama"
# AI_BASE_URL=""
# AI_MODEL=""
# AI_API_KEY=""

# Kally (Fase 2): modelo de visão (anexos de imagem), embeddings da memória, modelo
# usado nas revisões (melhor em português que o llama3.2) e tempo que o Ollama mantém
# os modelos carregados.
# AI_VISION_MODEL="gemma3:4b"
# AI_EMBED_MODEL="nomic-embed-text"
KALLY_REVIEW_MODEL="gemma3:4b"
# AI_KEEP_ALIVE="30m"

# Pesquisa externa da Kally: "wikipedia" (padrão, sem chave), "brave" (BRAVE_API_KEY)
# ou "searxng" (SEARXNG_URL, instância própria).
# SEARCH_PROVIDER="wikipedia"
# BRAVE_API_KEY=""
# SEARXNG_URL=""

# Serviço Whisper local (a rota Next encaminha o áudio; mantenha o serviço em loopback).
WHISPER_URL="http://127.0.0.1:8001/transcribe"

# Kally — contexto do modelo para criação de posts, anexos e pesquisa (padrão 16384 tokens).
# Aumente se o modelo e a memória do servidor permitirem; diminua em máquinas modestas.
# OLLAMA_NUM_CTX="16384"

# Kally — leitura de imagens anexadas. Precisa de um modelo do Ollama com visão
# (ex.: `ollama pull llama3.2-vision`). Sem ele, imagens são recebidas mas NÃO interpretadas.
# OLLAMA_VISION_MODEL="llama3.2-vision"

# Kally — pesquisa na internet. Sem nenhuma das duas, usa DuckDuckGo HTML (sem chave, melhor esforço).
# SearXNG próprio com formato JSON habilitado (settings.yml: search.formats: [html, json]):
# SEARXNG_URL="http://127.0.0.1:8888"
# Ou Brave Search API (https://brave.com/search/api/):
# BRAVE_SEARCH_API_KEY=""
# Opcional: e-mail de contato enviado ao OpenAlex (artigos científicos), recomendado por eles.
# OPENALEX_MAILTO=""
