# Copie para .env e preencha. Nunca versione o .env.

# MongoDB local configurado como replica set de um nó
DATABASE_URL="mongodb://127.0.0.1:27018/minhamente?replicaSet=minhaMenteRS&directConnection=true"

# URL pública do site (metadados, sitemap, compartilhamento social)
SITE_URL="http://localhost:3000"

# Administrador único. Gere o hash com: npm run admin:hash
ADMIN_EMAIL="voce@exemplo.com"
ADMIN_PASSWORD_HASH=""

# Segredo para assinar a sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET=""

# Opcional: Gemini API key do Google AI Studio para leitura assistida.
GEMINI_API_KEY=""
# Opcional; por padrão usa gemini-2.5-flash.
# Opcional; por padrão usa gemini-3.8-flash.
GEMINI_MODEL="gemini-3.8-flash"
