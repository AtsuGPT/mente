{
  "expo": {
    "name": "Mente",
    "slug": "minha-mente",
    "scheme": "minhamente",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07060B",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07060B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "lang": "pt-BR",
      "description": "Um espaço pessoal para pensamentos, reflexões, ideias e aprendizados, organizados por ambientes e categorias.",
      "themeColor": "#07060B"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07060B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A Mente usa suas fotos para inserir imagens nos pensamentos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "A Mente usa o microfone para você falar ideias à Kally."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fe5176c5-750a-4a4d-afc8-ec9b5fe0f91b"
      }
    },
    "owner": "56tester"
  }
}
